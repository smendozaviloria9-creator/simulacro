@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center py-5">
        <div class="card shadow-sm border-0 p-4">
            <div class="card-body">
                <i class="bi bi-shield-lock-fill display-1 text-danger mb-3"></i>
                <h2 class="fw-bold text-danger">Access Denied</h2>
                <p class="text-muted mb-4">You do not have permission to access this resource or perform this action.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Log In with another account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
