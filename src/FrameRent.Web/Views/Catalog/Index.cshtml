@model IEnumerable<FrameRent.Application.DTOs.Equipment.EquipmentDto>
@{
    ViewData["Title"] = "Equipment Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Equipment Catalog</h2>
        <p class="text-muted mb-0">Browse and rent professional audiovisual equipment</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-secondary mb-2 align-self-start">@item.Category</span>
                    <h5 class="card-title fw-bold">@item.Name</h5>
                    <p class="card-text text-muted flex-grow-1 small">@item.Description</p>
                    
                    <div class="d-flex justify-content-between align-items-center my-3">
                        <div>
                            <span class="fs-4 fw-bold text-primary">$@item.DailyRate.ToString("0.00")</span>
                            <span class="text-muted small"> / day</span>
                        </div>
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-box-seam me-1"></i> @item.TotalUnits units
                        </span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary w-50 btn-sm">
                            <i class="bi bi-calendar-check me-1"></i> Check Dates
                        </a>
                        <a asp-action="Rent" asp-route-id="@item.Id" class="btn btn-primary w-50 btn-sm">
                            <i class="bi bi-bag-plus me-1"></i> Rent Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
